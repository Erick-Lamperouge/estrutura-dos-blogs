---
import '../styles/blog.css';
import '@fontsource/barlow-condensed/800.css';
import '@fontsource-variable/source-serif-4';
import '@fontsource-variable/inter';
import BlogIcon from './BlogIcon.astro';
import {localizedView} from '../lib/international.mjs';
import {designView,themeVariables} from '../lib/design.mjs';
import {previewSeo} from '../lib/seo.mjs';
import {siteContext,publicationLabels} from '../lib/site-context.mjs';
import {safeJson} from '../lib/publication-plan.mjs';
const {config,locale=config.language,title,description,articleEditions,isArticle=false,articleData}=Astro.props;
const view=localizedView(config,locale);
const d=designView(config,view);
const u=view.ui, t=d.ui;
const vars=themeVariables(config);
const themeKey='sm-blog-theme:'+config.slug;
const home=view.home;
const ref=config.design.refinement;
const editions=articleEditions??view.editions;
const anchor=(name:string)=>isArticle?home+'#'+name:'#'+name;
const context=siteContext(config),live=context.live,pub=publicationLabels(locale);
const seo=live?context.seo(Astro.url.pathname):previewSeo(config,locale,editions,Astro.url.pathname);
const pageTitle=title?title+' — '+config.name:config.name+' — '+(live?view.tagline:u.preview);
const pageDescription=description??view.description;
---
<!doctype html>
<html lang={view.language} data-blog-theme-key={themeKey} data-blog-theme-default={d.appearance.default} data-blog-light-color={d.appearance.light.background} data-blog-dark-color={config.theme.background}>
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1"/>
  <meta name="robots" content={seo.robots}/>
  {seo.canonical&&<link rel="canonical" href={seo.canonical}/>}
  {seo.alternates.map(alt=><link rel="alternate" hreflang={alt.locale} href={alt.href}/>)}
  <meta name="description" content={pageDescription}/>
  <meta name="theme-color" content={config.theme.background}/>
  <title>{pageTitle}</title>
  {seo.canonical&&<>
    <meta property="og:type" content={live&&articleData?"article":"website"}/>
    <meta property="og:title" content={pageTitle}/>
    <meta property="og:description" content={pageDescription}/>
    <meta property="og:url" content={seo.canonical}/>
    <meta property="og:site_name" content={config.name}/>
  </>}
  {live&&articleData&&<><meta property="article:published_time" content={articleData.datePublished}/><meta property="article:modified_time" content={articleData.dateModified}/><script type="application/ld+json" is:inline set:html={safeJson(articleData)}></script></>}
  <script is:inline>
    (()=>{
      const root=document.documentElement;
      let preference=root.dataset.blogThemeDefault||"system";
      try{const stored=localStorage.getItem(root.dataset.blogThemeKey);if(["system","light","dark"].includes(stored))preference=stored;}catch{}
      const theme=preference==="system"?(matchMedia("(prefers-color-scheme: dark)").matches?"dark":"light"):preference;
      root.dataset.blogPreference=preference;
      root.dataset.blogTheme=theme;
      document.querySelector("meta[name=theme-color]")?.setAttribute("content",theme==="dark"?root.dataset.blogDarkColor:root.dataset.blogLightColor);
    })();
  </script>
</head>
<body class="blog" style={vars} data-motif={d.motif} data-density={d.density} data-typography={ref.typography} data-navigation={ref.navigation} data-action={ref.action} data-motion={ref.motion}>
  <a class="skip" href="#content">{u.skip}</a>
  <div class="blog-notice">{live?pub.notice:u.notice}</div>
  <header class="blog-header" id="top">
    <div class="blog-wrap masthead">
      <div class="masthead-top">
        <span class="edition"><span class="edition-dot" aria-hidden="true"></span>{t.edition}</span>
        <div class="header-controls">
        <div class="appearance-control" id="appearance-control" hidden>
          <label for="blog-theme">{t.appearance}</label>
          <select id="blog-theme"><option value="system">{t.system}</option><option value="light">{t.light}</option><option value="dark">{t.dark}</option></select>
        </div>
        <nav class="blog-languages" aria-label={u.language}>
          {editions.map(edition=><a href={edition.href} lang={edition.locale} hreflang={edition.locale} aria-current={edition.locale===view.language?'page':undefined}>{edition.label}</a>)}
        </nav>
        </div>
      </div>
      <div class="brand-line">
        <div>
          <a class="brand" href={home}>{config.name}<span aria-hidden="true">.</span></a>
          <p class="tagline">{view.tagline}</p>
        </div>
        <a class="search-link" href={anchor("pauta-search")}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></svg><span>{t.search}</span></a>
      </div>
      <nav class="primary-nav" aria-label={live?pub.navigation:u.navigation}>
        <a class="home-link" href={home} aria-current={isArticle?undefined:'page'}><span class="nav-icon"><BlogIcon name="home"/></span><span>{u.home}</span></a>
        {d.primary.map(category=><a href={isArticle?home+'?editoria='+category.slug+'#stories':'#stories'} data-nav-category={isArticle?undefined:category.slug}><span class="nav-icon"><BlogIcon name={category.slug}/></span><span>{category.label}</span></a>)}
        <a href={anchor("sections")}><span class="nav-icon"><BlogIcon name="sections"/></span><span>{u.categories}</span></a>
      </nav>
    </div>
  </header>
  <slot/>
  <footer class="blog-footer">
    <div class="blog-wrap footer-inner"><div><a class="footer-brand" href={home}>{config.name}<span>.</span></a><p>{t.network}{!live&&" · "+u.preview}</p></div><a href="#top">{t.return} ↑</a></div>
  </footer>
  <script>
    const root=document.documentElement;
    const picker=document.querySelector<HTMLSelectElement>('#blog-theme');
    const control=document.querySelector<HTMLElement>('#appearance-control');
    const system=matchMedia('(prefers-color-scheme: dark)');
    function updateTheme(preference:string,persist=false){
      if(!['system','light','dark'].includes(preference))preference='system';
      const mode=preference==='system'?(system.matches?'dark':'light'):preference;
      root.dataset.blogPreference=preference;
      root.dataset.blogTheme=mode;
      if(picker)picker.value=preference;
      const color=mode==='dark'?root.dataset.blogDarkColor:root.dataset.blogLightColor;
      if(color)document.querySelector('meta[name=theme-color]')?.setAttribute('content',color);
      if(persist)try{localStorage.setItem(root.dataset.blogThemeKey??'',preference);}catch{}
    }
    updateTheme(root.dataset.blogPreference??root.dataset.blogThemeDefault??'system');
    if(control&&picker){control.hidden=false;picker.addEventListener('change',()=>updateTheme(picker.value,true));}
    system.addEventListener('change',()=>{if(root.dataset.blogPreference==='system')updateTheme('system');});
  </script>
</body>
</html>
