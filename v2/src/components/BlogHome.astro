---
import BlogShell from './BlogShell.astro';
import EditorialAction from './EditorialAction.astro';
import {articleListing} from '../lib/articles.mjs';
import articleCatalog from '../../content/articles.json';
import seriesCatalog from '../../content/series.json';
import {seriesList,seriesLabels} from '../lib/series.mjs';
import {localizedView} from '../lib/international.mjs';
import {designView,themeVariables} from '../lib/design.mjs';
const {config,locale=config.language}=Astro.props;
const view=localizedView(config,locale);
const d=designView(config,view);
const u=view.ui, t=d.ui;
const mediaLabel=(kind:string)=>kind==='photo'?t.photo:kind==='chart'?t.chart:t.illustration;
const realCards=articleListing(config,articleCatalog,locale);
const cards=realCards.length?realCards:d.cards.map((card,i)=>({...card,id:'fixture-'+i,href:null,summary:null}));
const series=seriesList(config,articleCatalog,seriesCatalog,locale), sl=seriesLabels(locale);
---
<BlogShell config={config} locale={locale}>
  <main class="blog-wrap" id="content">
    <div class="ad-preview ad-banner" aria-label={t.ad}>{t.ad}</div>
    <div class="blog-grid">
      <div class="editorial-main">
        <div class="section-kicker"><span>{t.featured}</span><span class="rule"></span><span class="muted">{u.preview}</span></div>
        <section class="feature" aria-labelledby="feature-heading">
          {d.featured.media.source==="local"?<figure class="feature-media"><img src={d.featured.media.path} alt={d.featured.media.alt[view.language]} decoding="async" fetchpriority="high"/><figcaption>{mediaLabel(d.featured.media.kind)} · {t.mediaCredit}: {d.featured.media.credit}</figcaption></figure>:<div class="feature-art" role="img" aria-label={t.illustration}>
            <svg class="feature-svg" viewBox="0 0 820 390" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
              <defs><pattern id="grid" width="36" height="36" patternUnits="userSpaceOnUse"><path d="M36 0H0V36" fill="none" stroke="currentColor" stroke-opacity=".1"/></pattern></defs>
              <rect width="820" height="390" fill="url(#grid)"/>
              {d.motif==='pitch'?<g fill="none" stroke="currentColor">
                <g opacity=".22" stroke-width="2"><rect x="78" y="32" width="664" height="326" rx="4"/><path d="M410 32v326M78 117h120v156H78m664-156H622v156h120M78 153h47v84H78m664-84h-47v84h47"/><circle cx="410" cy="195" r="54"/><circle cx="410" cy="195" r="3"/></g>
                <g stroke-width="3" stroke-dasharray="8 9" opacity=".9"><path d="M180 288 307 223 437 272 548 146 654 91"/><path d="M307 223 347 106 548 146"/></g>
                {[ [180,288],[307,223],[437,272],[548,146],[654,91],[347,106] ].map(([x,y],i)=><g><circle cx={x} cy={y} r="18" fill="var(--blog-background)" stroke-width="2.5"/><circle cx={x} cy={y} r={i===4?9:5} fill="currentColor" stroke="none"/></g>)}
                <path d="m637 87 17 4-6 16" stroke-width="3"/>
              </g>:d.motif==='table'?<g fill="none" stroke="currentColor" stroke-width="2.5">
                <circle cx="410" cy="195" r="146" opacity=".35"/><circle cx="410" cy="195" r="106" opacity=".65"/><circle cx="410" cy="195" r="66" stroke-dasharray="8 10"/>
                <path d="M230 75v225m-15-225v70q15 38 30 0V75m350 0v225m0-225q-44 65 0 122" opacity=".8"/><path d="M390 157q-55-44-46 15t64 65q55 32 76-23t-49-45" opacity=".8"/><path d="M421 143q31-51 70-40-8 53-70 40Z" fill="currentColor" opacity=".5"/>
              </g>:<g stroke="currentColor" fill="none" stroke-width="2" opacity=".7"><circle cx="410" cy="195" r="142"/><circle cx="410" cy="195" r="95"/><path d="M90 310 330 70l155 220 220-170"/></g>}
            </svg>
            <span class="art-label">{t.illustration}</span>
            <span class="art-index" aria-hidden="true">01</span>
          </div>}
          <div class="feature-copy">
            <span class="eyebrow">{d.featured.category}</span>
            <h1 id="feature-heading">{d.featured.title}</h1>
            <p>{d.featured.summary}</p>
            <span class="draft-label">{t.draft}</span>
          </div>
        </section>
        {series.length>0&&<section class="series-feature section-block" id="series"><div class="section-kicker"><h2>{sl.title}</h2><span class="rule"></span></div><p class="muted">{sl.intro}</p>{series.filter(s=>s.href).slice(0,2).map(s=><div class="series-panel"><span class="eyebrow">{sl.draft} · {s.ready}/{s.total}</span><h3>{s.title}</h3><p>{s.description}</p><EditorialAction href={s.href} label={sl.open}/></div>)}<EditorialAction href={view.home+'series/'} label={sl.all}/></section>}
        <section id="sections" class="section-block">
          <div class="section-kicker"><h2>{t.topics}</h2><span class="rule"></span></div>
          <div class="category-list" aria-label={t.topics}>
            <button type="button" data-category-filter="all" aria-pressed="true">{t.all}</button>
            {view.categories.map(category=><button type="button" data-category-filter={category.slug} aria-pressed="false">{category.label}</button>)}
          </div>
        </section>
        <section id="stories" class="section-block">
          <div class="section-kicker"><h2>{t.stories}</h2><span class="rule"></span><span class="muted">{u.preview}</span></div>
          <div class="search-tools">
            <div class="search-field">
              <label for="pauta-search">{t.filter}</label>
              <input id="pauta-search" type="search" placeholder={u.placeholder} autocomplete="off"/>
            </div>
            <button id="clear-filters" class="clear-button" type="button">{t.clear}</button>
          </div>
          <p id="pauta-status" role="status" class="muted" data-count={u.count} data-empty={t.empty}></p>
          <ul class="pauta-list">{cards.map((card,i)=><li data-pauta data-article-id={card.id} data-category={card.slug} class:list={["pauta",{"with-media":card.media?.source==="local"}]}>
            {card.media?.source==="local"?<figure class="story-media"><img src={card.media.path} alt={card.media.alt[view.language]} loading="lazy" decoding="async"/><figcaption>{mediaLabel(card.media.kind)} · {card.media.credit}</figcaption></figure>:<div class="story-number" aria-hidden="true">{String(i+2).padStart(2,'0')}<span></span></div>}
            <div class="story-copy"><span class="eyebrow">{card.category}</span><h3>{card.title}</h3>{card.summary&&<p class="story-summary">{card.summary}</p>}<span class="draft-label">{card.href?t.articleDraft:t.draft}</span>{card.href&&<EditorialAction href={card.href} label={t.readDraft}/>}</div>
          </li>)}</ul>
        </section>
      </div>
      <aside class="editorial-aside" aria-label={u.complementary}>
        <div class="ad-preview ad-side">{t.ad}</div>
        <section class="side-panel editorial-promise">
          <span class="side-index">01 / {t.edition}</span>
          <h2>{t.method}</h2><p>{t.methodText}</p>
        </section>
        <section class="side-panel"><span class="side-index">02</span><h2>{t.about}</h2><p>{view.description}</p></section>
        <section class="side-panel"><span class="side-index">03</span><h2>{t.guide}</h2><p>{t.guideText}</p></section>
      </aside>
    </div>
  </main>
</BlogShell>
  <script>
    import {matchesPitch} from '../lib/design.mjs';
    const input=document.querySelector<HTMLInputElement>('#pauta-search');
    const status=document.querySelector<HTMLElement>('#pauta-status');
    const rows=[...document.querySelectorAll<HTMLElement>('[data-pauta]')];
    const buttons=[...document.querySelectorAll<HTMLButtonElement>('[data-category-filter]')];
    const fromUrl=new URLSearchParams(location.search).get('editoria');
    let selected=buttons.some(button=>button.dataset.categoryFilter===fromUrl)?fromUrl!:'all';
    const navLinks=[...document.querySelectorAll<HTMLAnchorElement>('[data-nav-category]')];
    const homeLink=document.querySelector('.primary-nav .home-link');
    function apply(){
      let found=0;
      for(const row of rows){row.hidden=!matchesPitch(row.textContent,row.dataset.category,input?.value,selected);if(!row.hidden)found++;}
      for(const button of buttons)button.setAttribute('aria-pressed',String(button.dataset.categoryFilter===selected));
      for(const link of navLinks){if(link.dataset.navCategory===selected)link.setAttribute('aria-current','true');else link.removeAttribute('aria-current');}
      if(selected==='all')homeLink?.setAttribute('aria-current','page');else homeLink?.removeAttribute('aria-current');
      if(status)status.textContent=found===0?(status.dataset.empty??''):found+' '+(status.dataset.count??'');
    }
    input?.addEventListener('input',apply);
    for(const button of buttons)button.addEventListener('click',()=>{selected=button.dataset.categoryFilter??'all';apply();});
    for(const link of document.querySelectorAll<HTMLElement>('[data-nav-category]'))link.addEventListener('click',()=>{selected=link.dataset.navCategory??'all';if(input)input.value='';apply();});
    document.querySelector('#clear-filters')?.addEventListener('click',()=>{selected='all';if(input)input.value='';apply();input?.focus();});
    apply();
  </script>
