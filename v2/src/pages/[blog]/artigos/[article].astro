---
import ArticlePage from '../../../components/ArticlePage.astro';
import {validateArticles} from '../../../lib/articles.mjs';
import {siteConfigs,siteContext} from '../../../lib/site-context.mjs';
export function getStaticPaths(){return siteConfigs.flatMap(config=>validateArticles(config,siteContext(config).articles).map(a=>({params:{blog:config.slug,article:a.editions[config.language].slug},props:{config,id:a.id,locale:config.language}})));}
---
<ArticlePage {...Astro.props} catalog={siteContext(Astro.props.config).articles}/>
