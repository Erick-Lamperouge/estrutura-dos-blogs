---
import BlogHome from '../../../components/BlogHome.astro';
import { validateBlogConfig } from '../../../lib/config.mjs';
import football from '../../../../config/futebolando.json';
import cooking from '../../../../config/culinaria-demo.json';
export function getStaticPaths() {
  return [football, cooking].flatMap(config => config.international.editions.filter(edition=>edition.path).map(edition=>({params:{blog:config.slug,locale:edition.path},props:{config,locale:edition.locale}})));
}
const config = validateBlogConfig(Astro.props.config);
const locale = Astro.props.locale;
---
<BlogHome config={config} locale={locale} />
