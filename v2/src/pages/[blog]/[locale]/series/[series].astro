---
import SeriesPage from '../../../../components/SeriesPage.astro';
import {validateSeries} from '../../../../lib/series.mjs';
import {siteConfigs,siteContext} from '../../../../lib/site-context.mjs';
export function getStaticPaths(){
  return siteConfigs.flatMap(config=>{
    const rows=validateSeries(config,siteContext(config).articles,siteContext(config).series);
    if(!rows.length)return [];
    const editions=config.international.editions.filter(e=>e.path);
    return editions.flatMap(e=>rows.filter(s=>s.state!=='planned').map(s=>({params:{blog:config.slug,locale:e.path,series:s.copy[e.locale].slug},props:{config,locale:e.locale,id:s.id}})));
  });
}
---
<SeriesPage {...Astro.props} catalog={siteContext(Astro.props.config).articles} seriesCatalog={siteContext(Astro.props.config).series}/>
