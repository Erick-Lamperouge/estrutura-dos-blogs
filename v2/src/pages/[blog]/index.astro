---
import BlogHome from '../../components/BlogHome.astro';
import { validateBlogConfig } from '../../lib/config.mjs';
import {siteConfigs,siteContext} from '../../lib/site-context.mjs';
export function getStaticPaths() {
  return siteConfigs.map(config => ({params: {blog: config.slug}, props: {config}}));
}
const config = validateBlogConfig(Astro.props.config);
---
<BlogHome config={config} />
