---
import SeriesPage from '../../../components/SeriesPage.astro';
import {validateSeries} from '../../../lib/series.mjs';
import football from '../../../../config/futebolando.json';
import cooking from '../../../../config/culinaria-demo.json';
import catalog from '../../../../content/articles.json';
import seriesCatalog from '../../../../content/series.json';
export function getStaticPaths(){
  return [football,cooking].flatMap(config=>{
    const rows=validateSeries(config,catalog,seriesCatalog);
    if(!rows.length)return [];
    const editions=config.international.editions.filter(e=>!e.path);
    return editions.flatMap(e=>rows.filter(s=>s.state!=='planned').map(s=>({params:{blog:config.slug,series:s.copy[e.locale].slug},props:{config,locale:e.locale,id:s.id}})));
  });
}
---
<SeriesPage {...Astro.props} catalog={catalog} seriesCatalog={seriesCatalog}/>
